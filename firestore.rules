rules_version='2';service cloud.firestore{match /databases/{database}/documents{
function signed(){return request.auth!=null} function me(){return get(/databases/$(database)/documents/users/$(request.auth.uid)).data} function admin(){return signed()&&me().role=="admin";}
match /users/{id}{allow read:if signed()&&(request.auth.uid==id||admin());allow write:if admin();}
match /schedules/{id}{allow read:if signed();allow write:if admin();}
match /requests/{id}{allow read:if admin()||(signed()&&resource.data.createdBy==request.auth.uid);allow create:if signed()&&request.resource.data.createdBy==request.auth.uid;allow update,delete:if admin();}
}}